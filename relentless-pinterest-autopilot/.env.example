# Pinterest official API credentials (create an app at developers.pinterest.com)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=

# Optional: enables AI-assisted keyword/headline generation and DALL-E creative.
# Everything works without this via the built-in template/heuristic engines.
OPENAI_API_KEY=

# WordPress REST API credentials for content discovery (optional per site;
# public sites work read-only without these, but an application password
# raises rate limits and exposes draft/private content scoring if desired).
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Database
DATABASE_URL=sqlite:///data/autopilot.db

# Kill switches / volume controls
PUBLISHING_ENABLED=true
GENERATION_ENABLED=true
AUTO_OPTIMIZATION_ENABLED=true
DAILY_PIN_TARGET=5
MIN_QUEUE_DAYS=14
TARGET_QUEUE_DAYS=30
