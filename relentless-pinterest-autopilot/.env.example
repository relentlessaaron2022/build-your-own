# Pinterest official API credentials (developers.pinterest.com).
# App: WEBFILMBOOKS Content Automation (app ID 1611009).
# PINTEREST_APP_ID / PINTEREST_APP_SECRET are preferred.
# PINTEREST_CLIENT_ID / PINTEREST_CLIENT_SECRET are accepted aliases.
# `pinterest connect` fills the access and refresh tokens. Never commit this file.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
# Must match the redirect URI registered on the Pinterest app. http is allowed for localhost.
PINTEREST_REDIRECT_URI=http://localhost:8085/pinterest/callback

# Optional: enables AI-assisted keyword/headline generation and DALL-E creative.
# Everything works without this via the built-in template/heuristic engines.
OPENAI_API_KEY=

# WordPress REST API credentials for content discovery (optional per site;
# public sites work read-only without these, but an application password
# raises rate limits and exposes draft/private content scoring if desired).
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Database
DATABASE_URL=sqlite:///data/autopilot.db
# Optional absolute checkout/runtime directory (must contain config/).
# Set for a non-editable wheel install or service with a separate runtime home.
# AUTOPILOT_HOME=/absolute/path/to/relentless-pinterest-autopilot
SCHEDULER_TIMEZONE=America/New_York

# Kill switches / volume controls
PUBLISHING_ENABLED=true
GENERATION_ENABLED=true
AUTO_OPTIMIZATION_ENABLED=true
DAILY_PIN_TARGET=5
MIN_QUEUE_DAYS=14
TARGET_QUEUE_DAYS=30

# Social source readers: use the version enabled for your own Meta app.
META_GRAPH_VERSION=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_1_ACCESS_TOKEN=
INSTAGRAM_2_ACCESS_TOKEN=
INSTAGRAM_3_ACCESS_TOKEN=
INSTAGRAM_4_ACCESS_TOKEN=
INSTAGRAM_5_ACCESS_TOKEN=
INSTAGRAM_MZPEARLIVY_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# YouTube public feeds need a channel ID in config/social_accounts.json, not a token.
