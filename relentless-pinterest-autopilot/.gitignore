# Env
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Runtime data (regenerated by scripts/init_db.py + the scheduler)
data/*.db
data/*.db-journal
data/state.json
logs/*.log*
assets/generated/*.png
reports/*.md

# Keep directory structure
!data/.gitkeep
!logs/.gitkeep
!assets/generated/.gitkeep
!reports/.gitkeep
